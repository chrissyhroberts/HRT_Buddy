<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:orientation="vertical" android:padding="14dp" android:background="#F1EEFF" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/widget_title" android:text="HRT BUDDY  ·  FULL CYCLE" android:textColor="#6558C8" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/widget_day" android:text="Day 1 / 28" android:textColor="#211E29" android:textSize="20sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/widget_status" android:text="No tasks due today" android:textColor="#514C5F" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="TODAY" android:textColor="#6558C8" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:id="@+id/widget_actions" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="5dp">
        <Button android:id="@+id/widget_action_patch" android:text="Change patch" android:textColor="#6558C8" android:textSize="12sp" android:gravity="center_vertical|start" android:textAllCaps="false" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="#FFFFFF" android:layout_width="match_parent" android:layout_height="32dp"/>
        <Button android:id="@+id/widget_action_pill" android:text="Take progesterone" android:textColor="#6558C8" android:textSize="12sp" android:gravity="center_vertical|start" android:textAllCaps="false" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="#FFFFFF" android:layout_width="match_parent" android:layout_height="32dp"/>
        <Button android:id="@+id/widget_action_checkin" android:text="Health check" android:textColor="#6558C8" android:textSize="12sp" android:gravity="center_vertical|start" android:textAllCaps="false" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="#FFFFFF" android:layout_width="match_parent" android:layout_height="32dp"/>
    </LinearLayout>
    <TextView android:text="CYCLE MAP" android:textColor="#6558C8" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="18dp"/>
    <TextView android:id="@+id/widget_map_patch_text" android:text="Patch  ···································" android:textColor="#514C5F" android:textSize="10sp" android:maxLines="1" android:ellipsize="none" android:fontFamily="monospace" android:layout_width="match_parent" android:layout_height="18dp"/>
    <TextView android:id="@+id/widget_map_prog_text" android:text="Prog.  ···································" android:textColor="#514C5F" android:textSize="10sp" android:maxLines="1" android:ellipsize="none" android:fontFamily="monospace" android:layout_width="match_parent" android:layout_height="18dp"/>
    <TextView android:id="@+id/widget_map_bleeding_text" android:text="Blood  ···································" android:textColor="#514C5F" android:textSize="10sp" android:maxLines="1" android:ellipsize="none" android:fontFamily="monospace" android:layout_width="match_parent" android:layout_height="18dp"/>
    <TextView android:id="@+id/widget_map_pain_text" android:text="Pain   ···································" android:textColor="#514C5F" android:textSize="10sp" android:maxLines="1" android:ellipsize="none" android:fontFamily="monospace" android:layout_width="match_parent" android:layout_height="18dp"/>
    <TextView android:id="@+id/widget_map_mood_text" android:text="Mood   ···································" android:textColor="#514C5F" android:textSize="10sp" android:maxLines="1" android:ellipsize="none" android:fontFamily="monospace" android:layout_width="match_parent" android:layout_height="18dp"/>
    <TextView android:id="@+id/widget_map_overall_text" android:text="Feel   ···································" android:textColor="#514C5F" android:textSize="10sp" android:maxLines="1" android:ellipsize="none" android:fontFamily="monospace" android:layout_width="match_parent" android:layout_height="18dp"/>
    <TextView android:id="@+id/widget_map_today_marker" android:text="       ▲" android:textColor="#CD414C" android:textSize="10sp" android:maxLines="1" android:ellipsize="none" android:fontFamily="monospace" android:layout_width="match_parent" android:layout_height="14dp"/>
</LinearLayout>
